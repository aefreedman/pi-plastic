  {
    "name": "plastic_patch",
    "label": "plastic_patch",
    "description": "Generate a Plastic SCM review patch with a patch-specific non-GUI diff backend; branch selectors are qualified to the current workspace repository and requested outputs publish atomically without overwrite (cm patch).",
    "parameters": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Source changeset or branch spec. Unqualified br:/ selectors are qualified only from the exact current workspace repository.",
          "minimum": 1
        },
        "destination": {
          "type": "string",
          "description": "Optional second changeset or branch spec for two-spec patch generation."
        },
        "output": {
          "type": "string",
          "description": "Optional new output file path. The package stages then atomically publishes it and refuses any existing path. If omitted, patch content is returned."
        },
        "toolPath": {
          "type": "string",
          "description": "Optional patch-capable non-GUI diff executable for this call (highest priority). Otherwise use PI_PLASTIC_PATCH_EXECUTABLE; non-Windows falls back to PI_PLASTIC_DIFF_EXECUTABLE/diff, which must support the local Plastic patch argument contract."
        },
        "clean": {
          "type": "boolean",
          "description": "Exclude content that arrived via merges and include only direct checkins."
        },
        "integration": {
          "type": "boolean",
          "description": "Show branch changes pending integration into the parent branch."
        },
        "workdir": {
          "type": "string",
          "description": "Working directory for the workspace."
        }
      }
    },
    "defaults": {},
    "hasOutputSchema": false
  },
  {
    "name": "plastic_branchCreate",
    "label": "plastic_branchCreate",
    "description": "Create a hierarchical Plastic SCM branch, guarding rare top-level branch creation (cm branch create).",
    "parameters": {
      "type": "object",
      "required": [
        "branch"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "description": "Relative new-branch name or full hierarchical branch path. A relative name uses parent, or the current branch when parent is omitted.",
          "minimum": 1
        },
        "parent": {
          "type": "string",
          "description": "Parent branch for a relative branch name. May differ from the workspace branch; Plastic uses the parent's latest changeset by default."
        },
        "changeset": {
          "type": "string",
          "description": "Changeset used as the starting point instead of the parent branch's latest changeset."
        },
        "label": {
          "type": "string",
          "description": "Label used as the starting point."
        },
        "comment": {
          "type": "string",
          "description": "Optional branch comment."
        },
        "commentsFile": {
          "type": "string",
          "description": "File path containing the branch comment."
        },
        "allowRootBranch": {
          "type": "boolean",
          "description": "Allow intentional top-level branch creation such as /<new-branch>. Defaults to false."
        },
        "workdir": {
          "type": "string",
          "description": "Working directory for the workspace."
        }
      }
    },
    "defaults": {},
    "hasOutputSchema": true
  },
  {
    "name": "plastic_switchBranch",
    "label": "plastic_switchBranch",
    "description": "Switch the Plastic SCM workspace to a branch (cm switch), handling pending changes when needed.",
    "parameters": {
      "type": "object",
      "required": [
        "branch"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "description": "Branch name or spec selected from the current repository convention.",
          "minimum": 1
        },
        "pendingChanges": {
          "anyOf": [
            {
              "type": "string",
              "const": "shelve"
            },
            {
              "type": "string",
              "const": "bring"
            },
            {
              "type": "string",
              "const": "cancel"
            }
          ],
          "description": "How to handle pending changes when switching branches. Defaults to cancel. In unattended mode, bring is blocked only when tracked pending changes exist."
        },
        "preflight": {
          "type": "boolean",
          "description": "Preview switch strategy without executing switch."
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "json"
            }
          ],
          "description": "Output format. Defaults to text."
        },
        "workdir": {
          "type": "string",
          "description": "Working directory for the workspace."
        }
      }
    },
    "defaults": {},
    "hasOutputSchema": true
  },
  {
    "name": "plastic_merge",
    "label": "plastic_merge",
    "description": "Merge safely with explicit non-interactive conflict strategy (cm merge --merge --nointeractiveresolution).",
    "parameters": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Source branch/changeset/label/shelveset spec to merge from.",
          "minimum": 1
        },
        "strategy": {
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "string",
              "const": "source"
            },
            {
              "type": "string",
              "const": "destination"
            }
          ],
          "description": "Conflict resolution strategy. auto tries non-destructive auto-resolution and aborts if manual conflict remains. source/destination are explicit overrides."
        },
        "cherrypicking": {
          "type": "boolean",
          "description": "Enable cherry-picking mode."
        },
        "forced": {
          "type": "boolean",
          "description": "Skip connected-branch checks when supported by the merge mode."
        },
        "preflight": {
          "type": "boolean",
          "description": "Preview command without executing merge."
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "json"
            }
          ],
          "description": "Output format. Defaults to text."
        },
        "workdir": {
          "type": "string",
          "description": "Working directory for the workspace."
        }
      }
    },
    "defaults": {},
    "hasOutputSchema": false
  },
  {
    "name": "plastic_mergeBranches",
    "label": "plastic_mergeBranches",
    "description": "One bounded workspace-free server merge receipt; server aliases, merge links and Xlink effects remain unverified.",
    "parameters": {
      "type": "object",
      "required": [
        "source",
        "target",
        "message"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Fully qualified source branch; branch/repository may not contain @; full server tail retained.",
          "minimum": 1
        },
        "target": {
          "type": "string",
          "description": "Fully qualified distinct target in the same exact requested repository/server.",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "description": "Required bounded nonempty comment; no editor fallback.",
          "minimum": 1
        },
        "preflight": {
          "type": "boolean",
          "description": "Render intent only, zero commands; does not analyze remote conflicts."
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "json"
            }
          ],
          "description": "Output format. Defaults to text."
        }
      }
    },
    "defaults": {},
    "hasOutputSchema": true
  },
  {
    "name": "plastic_mergeToBranch",
    "label": "plastic_mergeToBranch",
    "description": "Merge a source branch into a target branch using safe Plastic update, switch, merge, and checkin steps.",
    "parameters": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Source branch to merge. Defaults to the currently loaded branch."
        },
        "target": {
          "type": "string",
          "description": "Target branch to merge into. Defaults to the source branch's Plastic parent branch."
        },
        "cardRef": {
          "type": "string",
          "description": "Optional tracker card reference to include in the merge checkin message, for example $4re."
        },
        "message": {
          "type": "string",
          "description": "Optional checkin message. Defaults to Merge <source> into <target>."
        },
        "strategy": {
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "string",
              "const": "source"
            },
            {
              "type": "string",
              "const": "destination"
            }
          ],
          "description": "Merge conflict strategy. Defaults to auto."
        },
        "updateTarget": {
          "type": "boolean",
          "description": "Run plastic_update on the target branch before merging. Defaults to true."
        },
        "includePrivate": {
          "type": "boolean",
          "description": "Include private items in the merge checkin. Defaults to false."
        },
        "preflight": {
          "type": "boolean",
          "description": "Preview the planned closeout merge steps without executing them."
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "json"
            }
          ],
          "description": "Output format. Defaults to text."
        },
        "workdir": {
          "type": "string",
          "description": "Working directory for the workspace."
        }
      }
    },
    "defaults": {},
    "hasOutputSchema": false
  },
  {
    "name": "plastic_finalizeMerge",
    "label": "plastic_finalizeMerge",
    "description": "Finalize Plastic merge metadata after manual conflict resolution using an explicit non-interactive source/destination policy.",
