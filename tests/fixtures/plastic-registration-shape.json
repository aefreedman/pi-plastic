          "type": "string",
          "description": "Original source branch/changeset/label/shelveset spec being merged.",
          "minimum": 1
        },
        "strategy": {
          "anyOf": [
            {
              "type": "string",
              "const": "source"
            },
            {
              "type": "string",
              "const": "destination"
