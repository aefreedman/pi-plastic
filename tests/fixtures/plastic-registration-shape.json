  {
    "name": "plastic_branchList",
    "label": "plastic_branchList",
    "description": "List Plastic SCM branches using cm find branch with optional filters.",
    "parameters": {
      "type": "object",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string",
              "const": "native"
            },
            {
              "type": "string",
              "const": "names"
            }
          ],
          "description": "Observation source. Defaults to native table; names selects strict UTF-8 reusable branch rows."
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "json"
            }
          ],
          "description": "Output format. Defaults to text."
        },
        "maxItems": {
          "type": "integer",
          "description": "Canonical projection rows (default 100); independent of the CLI query limit. Native rows are unavailable.",
          "minimum": 1,
          "maximum": 500
        },
        "nameLike": {
          "type": "string",
          "description": "Filter by branch leaf-name pattern (supports % wildcard); bounded to 4096 code units."
        },
