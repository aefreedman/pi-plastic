[
  {
    "name": "plastic_status",
    "label": "plastic_status",
    "description": "Show Plastic SCM workspace status (cm status).",
    "parameters": {
      "type": "object",
      "properties": {
        "workdir": {
          "type": "string",
          "description": "Working directory for the workspace."
        },
        "includeRevId": {
          "type": "boolean",
          "description": "Include revision IDs in the status output when supported."
        },
        "machineReadable": {
          "type": "boolean",
          "description": "Return parsed, machine-readable pending status records when supported."
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "machine"
            },
            {
              "type": "string",
              "const": "xml"
            }
          ],
          "description": "Explicit status source; omitted preserves machineReadable. XML is UTF-8, workspace-scoped, absolute paths, no short/base revisions, with synthesized presentation."
        },
        "maxItems": {
          "type": "integer",
          "description": "Maximum parsed items in machine-readable JSON (default 100, maximum 500).",
          "minimum": 1,
          "maximum": 500
        },
        "includeRaw": {
          "type": "boolean",
          "description": "Include raw machine output in JSON diagnostics, or bounded XML with a private metadata warning. Never included in the compact native DTO."
        },
        "short": {
          "type": "boolean",
          "description": "Use short status output."
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "json"
            }
          ],
          "description": "Output format. Defaults to text."
        }
      }
    },
    "defaults": {},
    "hasOutputSchema": true
  },
