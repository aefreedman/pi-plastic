        "format": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "json"
            }
          ],
          "description": "Output format. Defaults to text."
        },
        "workdir": {
          "type": "string",
          "description": "Working directory for the workspace."
        }
      }
    },
    "defaults": {},
    "hasOutputSchema": false
